modules = ["nodejs-24", "python-base-3.13"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[userenv]

[userenv.shared]
GOOGLE_APPS_SCRIPT_URL = "https://script.google.com/macros/s/AKfycbymwCbLD9-1XwvkfoH8KOFZG3DtaQVpk_rM-6CYvqfw2xGTAWR4n989R_4p5voFebGZXQ/exec"
